[Unit]
Description=Capture and publish daily Hacker News preview
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=hnpublisher
Group=hnpublisher
StateDirectory=hn-publisher
WorkingDirectory=/var/lib/hn-publisher
EnvironmentFile=/etc/hn-preview/publisher.env
Environment=XDG_CONFIG_HOME=/var/lib/hn-publisher/config
ExecStart=/usr/bin/flock /var/lib/hn-publisher/publish.lock /opt/hn-preview/tools/run.sh
TimeoutStartSec=1200
MemoryMax=512M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
UMask=0077
