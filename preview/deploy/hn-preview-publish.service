[Unit]
Description=Capture and publish daily Hacker News preview
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=hnpublisher
Group=hnpublisher
StateDirectory=hn-publisher
WorkingDirectory=/var/lib/hn-publisher
EnvironmentFile=/etc/hn-preview/publisher.env
Environment=HN_BIN=/opt/hn-preview/hn
Environment=XDG_CONFIG_HOME=/var/lib/hn-publisher/config
ExecStart=/opt/hn-preview/hn --capture-snapshot /var/lib/hn-publisher/candidate.json
ExecStart=/opt/hn-preview/hn --prepare-snapshot /var/lib/hn-publisher/candidate.json
ExecStart=/opt/hn-preview/node/bin/node /opt/hn-preview/publisher/publish.mjs /var/lib/hn-publisher/candidate.json
TimeoutStartSec=1200
MemoryMax=512M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
UMask=0077
